{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "Últimos valores",
      "queryLines": [
        "WITH u AS (SELECT * FROM ultimos_valores),\n",
        "m AS (SELECT max_by(ipca_12m_pct, mes) AS ipca_12m, max_by(mes, mes) AS mes_ipca\n",
        "      FROM indicadores_mensais WHERE ipca_12m_pct IS NOT NULL)\n",
        "SELECT\n",
        "  max(CASE WHEN serie = 'dolar_venda' THEN ultimo_valor END) AS dolar,\n",
        "  max(CASE WHEN serie = 'euro_venda'  THEN ultimo_valor END) AS euro,\n",
        "  max(CASE WHEN serie = 'selic_meta'  THEN ultimo_valor END) AS selic,\n",
        "  max(m.ipca_12m)                                            AS ipca_12m,\n",
        "  concat('Ref.: ', date_format(max(CASE WHEN serie = 'dolar_venda' THEN data_referencia END), 'dd/MM/yyyy')) AS ref\n",
        "FROM u CROSS JOIN m\n"
      ]
    },
    {
      "name": "ds_cambio",
      "displayName": "Câmbio diário",
      "queryLines": [
        "SELECT data, dolar, euro, dolar_media_30d, euro_media_30d, dolar_variacao_pct\n",
        "FROM cambio_diario\n",
        "ORDER BY data\n"
      ]
    },
    {
      "name": "ds_mensal",
      "displayName": "Indicadores mensais",
      "queryLines": [
        "SELECT mes AS data, dolar_medio, dolar_fechamento, euro_medio, selic_meta_pct_aa, cdi_acumulado_mes_pct,\n",
        "       ipca_mes_pct, ipca_12m_pct, juro_real_aprox_pct, dias_uteis\n",
        "FROM indicadores_mensais\n",
        "ORDER BY mes\n"
      ]
    }
  ],
